{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BookingDb": "Host=localhost;Port=5434;Database=bookingdb;Username=postgres;Password=postgres"
  },
  "UserJwtToken": {
    "Secret": "",
    "Issuer": "event-manager-backend",
    "Audience": "event-manager-frontend",
    "Lifetime": "00:30:00"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "booking-service-1"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "OTEL_SERVICE_NAME": "booking-service",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=1.0.0"
}
