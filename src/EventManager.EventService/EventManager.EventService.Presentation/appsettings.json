{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EventsDb": "Host=localhost;Port=5433;Database=eventdb;Username=postgres;Password=postgres"
  },
  "UserJwtToken": {
    "Secret": "",
    "Issuer": "event-manager-backend",
    "Audience": "event-manager-frontend",
    "Lifetime": "00:30:00"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "event-service-1"
  },
  "Redis": {
    "Endpoints": "localhost:6379",
    "EventTtl": "00:05:00",
    "TopEventsTtl": "01:00:00"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "OTEL_SERVICE_NAME": "event-service",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=1.0.0"
}
